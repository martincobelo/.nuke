set cut_paste_input [stack 0]
version 12.2 v11
BackdropNode {
 inputs 0
 name MagicSwitch_BackdropNode
 tile_color 0x8f00ff
 note_font_size 42
 note_font_color 0x757575ff
 selected true
 xpos -53
 ypos -414
 bdwidth 349
 bdheight 347
}
push $cut_paste_input
Group {
 name MagicSwitch
 onCreate "this_node = nuke.thisNode()\ninput_check_0 = this_node.input(0)\ninput_check_1 = this_node.input(1)\n\n# Grab the currently stored links\ncurrent_name0 = this_node.knob('input0UTXT').value()\ncurrent_name1 = this_node.knob('input1UTXT').value()\n\n# Check if the user is actively working (Paste/Create/modify) or just loading a file\nis_actively_working = nuke.root().modified()\n\n# Update link knobs based on connected inputs\nif input_check_0 != None:\n    name0 = input_check_0.name()\n    this_node.knob('input0UTXT').setValue(name0)\nelse:\n    # If pasting node without an input, reset it\n    if not is_actively_working and current_name0 not in (\"\", \"Connect input 0 to set link\"):\n        name0 = current_name0\n    # If loading a script, preserve the saved link \n    else:\n        name0 = \"Connect input 0 to set link\"\n        this_node.knob('input0UTXT').setValue(name0)\n        \nif input_check_1 != None:\n    name1 = input_check_1.name()\n    this_node.knob('input1UTXT').setValue(name1)\nelse:\n    if not is_actively_working and current_name1 not in (\"\", \"Connect input 1 to set link\"):\n        name1 = current_name1\n    else:\n        name1 = \"Connect input 1 to set link\"\n        this_node.knob('input1UTXT').setValue(name1)\n\n# Color Logic\ndef get_color(knob_name):\n    val = this_node.knob(knob_name).getValue()\n    if isinstance(val, (list, tuple)):\n        r = int(val\[0] * 255)\n        g = int(val\[1] * 255)\n        b = int(val\[2] * 255)\n        a = int(val\[3] * 255) if len(val) > 3 else 255\n        return (r << 24) | (g << 16) | (b << 8) | a\n    return int(val)\n\n# Fetch target nodes if they exist. Ignore placeholder strings\nt0 = nuke.toNode(name0) if name0 not in (\"\", \"Connect input 0 to set link\") else None\nt1 = nuke.toNode(name1) if name1 not in (\"\", \"Connect input 1 to set link\") else None\n\nis_disabled = this_node.knob('disable').getValue()\nwitch_val = int(this_node.knob('witchKNB').getValue())\n\nnew_knob = this_node.knob('newCHK')\nis_new = new_knob.value() if new_knob else False\n\n# Check if inputs are missing\nmissing = not is_new and ((name0 and not t0) or (name1 and not t1))\n\n# Apply the correct colors\nif missing:\n    new_color = get_color('missingInputCKNB')\nelif is_disabled:\n    new_color = get_color('disabledCKNB')\nelif witch_val == 0:\n    new_color = get_color('input0CKNB')\nelif witch_val == 1:\n    new_color = get_color('input1CKNB')\nelse:\n    new_color = get_color('inputOtherCKNB') \n\nthis_node.knob('tile_color').setValue(new_color)"
 knobChanged "def magicswitch_knob_callback():\n    k = nuke.thisKnob()\n    if not k:\n        return\n        \n    k_name = k.name()\n    valid_knobs = (\"inputChange\", \"witchKNB\", \"disable\", \"showStateCHK\",\n                   \"input0CKNB\", \"input1CKNB\", \"missingInputCKNB\", \"disabledCKNB\",\n                   \"disconnectInputsCHK\", \"inputOtherCKNB\", \"newCHK\",\n                   \"labelInputsCHK\", \"input0LabelUTXT\", \"input1LabelUTXT\",\"backdropColourDimDBL\")\n    if k_name not in valid_knobs:\n        return\n        \n    import re\n    n = nuke.thisNode()\n\n    # --- Disable Toggle Logic ---\n    if k_name == \"disable\":\n        witch_knob = n.knob('witchKNB')\n        if n.knob('disable').getValue():\n            # Node was disabled. store value, force to 0, and lock\n            n.knob('witchMemoryINT').setValue(int(witch_knob.getValue()))\n            witch_knob.setValue(0)\n            witch_knob.setEnabled(False)\n        else:\n            # Node was enabled. retrieve stored state and unlock\n            witch_knob.setValue(int(n.knob('witchMemoryINT').getValue()))\n            witch_knob.setEnabled(True)\n\n    # --- Helper Functions ---\n    def get_color_int(knob_name):\n        val = n.knob(knob_name).getValue()\n        if isinstance(val, (list, tuple)):\n            r = int(val\[0] * 255)\n            g = int(val\[1] * 255)\n            b = int(val\[2] * 255)\n            a = int(val\[3] * 255) if len(val) > 3 else 255\n            return (r << 24) | (g << 16) | (b << 8) | a\n        return int(val)\n\n    def dim_color(hex_int):\n        factor = n.knob('backdropColourDimDBL').value()\n        r = ((hex_int >> 24) & 255) * factor\n        g = ((hex_int >> 16) & 255) * factor\n        b = ((hex_int >> 8) & 255) * factor\n        a = (hex_int & 255)\n        return (int(r) << 24) | (int(g) << 16) | (int(b) << 8) | int(a)\n\n    def sanitize_name(text, default_name):\n        if not text:\n            return default_name\n        # Replace spaces with underscores\n        text = text.replace(' ', '_')\n        # Strip all special characters\n        clean = re.sub(r'\[^a-zA-Z0-9_]', '', text)\n        if not clean:\n            return default_name\n        # Cannot start with a number (add underscore if it does)\n        if clean\[0].isdigit():\n            clean = \"_\" + clean\n        return clean\n\n    # Update stored names\n    if k_name == \"inputChange\":\n        for i in \[0, 1]:\n            upstream = n.input(i)\n            if upstream:\n                n.knob('input' + str(i) + 'UTXT').setValue(upstream.name())\n\n    # Fetch target nodes and state\n    name0 = n.knob('input0UTXT').value()\n    name1 = n.knob('input1UTXT').value()\n    t0 = nuke.toNode(name0)\n    t1 = nuke.toNode(name1)\n    \n    is_disabled = n.knob('disable').getValue()\n    witch_val = int(n.knob('witchKNB').getValue())\n    \n    disconnect_knob = n.knob('disconnectInputsCHK')\n    disconnect_inputs = disconnect_knob.getValue() if disconnect_knob else True\n    \n    new_knob = n.knob('newCHK')\n    placeholders = (\"\", \"Connect input 0 to set link\", \"Connect input 1 to set link\")\n    \n    if new_knob and new_knob.value():\n        if name0 not in placeholders or name1 not in placeholders:\n            new_knob.setValue(False)\n            \n    is_new = new_knob.value() if new_knob else False\n\n    # Color Logic\n    missing = not is_new and ((name0 and not t0) or (name1 and not t1))\n\n    if missing:\n        new_color = get_color_int('missingInputCKNB')\n    elif is_disabled:\n        new_color = get_color_int('disabledCKNB')\n    elif witch_val == 0:\n        new_color = get_color_int('input0CKNB')\n    elif witch_val == 1:\n        new_color = get_color_int('input1CKNB')\n    else:\n        new_color = get_color_int('inputOtherCKNB') \n\n    n.knob('tile_color').setValue(new_color)\n    \n    # Backdrop Logic\n    parent_context = n.parent()\n    nx, ny = n.xpos() + n.screenWidth()/2, n.ypos() + n.screenHeight()/2\n    backdrop_color = dim_color(new_color)\n    \n    for node in parent_context.nodes():\n        if node.Class() == \"BackdropNode\" and node.name().startswith(\"MagicSwitch_\"):\n            bx, by = node.xpos(), node.ypos()\n            bw, bh = node.knob('bdwidth').value(), node.knob('bdheight').value()\n            if nx > bx and nx < (bx + bw) and ny > by and ny < (by + bh):\n                node.knob('tile_color').setValue(backdrop_color)\n\n    # Connection Logic\n    if k_name in (\"witchKNB\", \"disable\", \"disconnectInputsCHK\"):\n        if disconnect_inputs:\n            if is_disabled:\n                n.setInput(0, t0)\n                n.setInput(1, None)\n            else:\n                if witch_val == 0:\n                    n.setInput(0, t0)\n                    n.setInput(1, None)\n                elif witch_val == 1:\n                    n.setInput(0, None)\n                    n.setInput(1, t1)\n                else:\n                    n.setInput(0, None)\n                    n.setInput(1, None)\n        else:\n            n.setInput(0, t0)\n            n.setInput(1, t1)\n\n    # Internal Input Renaming Logic\n    if k_name in (\"labelInputsCHK\", \"input0LabelUTXT\", \"input1LabelUTXT\"):\n        label_chk_knob = n.knob('labelInputsCHK')\n        do_labels = label_chk_knob.value() if label_chk_knob else False\n        \n        # Grab raw text and safely format it\n        raw0 = n.knob('input0LabelUTXT').value()\n        raw1 = n.knob('input1LabelUTXT').value()\n        \n        target0 = sanitize_name(raw0, \"Input0\") if do_labels else \"Input0\"\n        target1 = sanitize_name(raw1, \"Input1\") if do_labels else \"Input1\"\n        \n        # Modify internal inputs\n        with n:\n            input_nodes = nuke.allNodes('Input')\n            \n            # Apply the safe input names\n            for inode in input_nodes:\n                if 'number' in inode.knobs():\n                    mid = int(inode\['number'].value())\n                    if mid == 0 and inode.name() != target0:\n                        inode.setName(target0)\n                    elif mid == 1 and inode.name() != target1:\n                        inode.setName(target1)\n\nmagicswitch_knob_callback()"
 autolabel "nuke.thisNode().name() \\\n+ ( \\\n    '\\n' + \\\n    ( \\\n        (nuke.thisNode()\['input0LabelUTXT'].value() + ' = ' if (0 if nuke.thisNode()\['disable'].value() else int(nuke.thisNode()\['witchKNB'].getValue())) == 0 and nuke.thisNode()\['input0LabelUTXT'].value() else \\\n        (nuke.thisNode()\['input1LabelUTXT'].value() + ' = ' if (0 if nuke.thisNode()\['disable'].value() else int(nuke.thisNode()\['witchKNB'].getValue())) == 1 and nuke.thisNode()\['input1LabelUTXT'].value() else '')) \\\n        if nuke.thisNode()\['showInputLabelCHK'].value() else '' \\\n    ) \\\n    + str((0 if nuke.thisNode()\['disable'].value() else int(nuke.thisNode()\['witchKNB'].getValue()))) \\\n    if nuke.thisNode()\['showStateCHK'].value() else \\\n    ( \\\n        ('\\n' + nuke.thisNode()\['input0LabelUTXT'].value() if (0 if nuke.thisNode()\['disable'].value() else int(nuke.thisNode()\['witchKNB'].getValue())) == 0 and nuke.thisNode()\['input0LabelUTXT'].value() else \\\n        ('\\n' + nuke.thisNode()\['input1LabelUTXT'].value() if (0 if nuke.thisNode()\['disable'].value() else int(nuke.thisNode()\['witchKNB'].getValue())) == 1 and nuke.thisNode()\['input1LabelUTXT'].value() else '')) \\\n        if nuke.thisNode()\['showInputLabelCHK'].value() else '' \\\n    ) \\\n) \\\n+ ('\\nMISSING LINK' if not nuke.thisNode()\['newCHK'].value() and ((nuke.thisNode()\['input0UTXT'].value() and not nuke.toNode(nuke.thisNode()\['input0UTXT'].value())) or (nuke.thisNode()\['input1UTXT'].value() and not nuke.toNode(nuke.thisNode()\['input1UTXT'].value()))) else '') \\\n+ ('\\n' + nuke.thisNode()\['label'].value() if nuke.thisNode()\['label'].value() else '')"
 tile_color 0xbf00ff
 selected true
 xpos 89
 ypos -242
 addUserKnob {20 optionsTAB l Options}
 addUserKnob {3 witchMemoryINT +HIDDEN}
 witchMemoryINT 1
 addUserKnob {7 witchKNB l Witch t "Pick which input to use for the linked nodes below"}
 witchKNB 1
 addUserKnob {26 ""}
 addUserKnob {1 input0UTXT l "Link 0" t "Type in the node name you want this input to connect to, or connect the input to the node to automatically populate the field with its name"}
 input0UTXT "Connect input 0 to set link"
 addUserKnob {1 input0LabelUTXT l Label t "Type in a custom label for this input. This can be displayed on the node label and/or in the node inputs" -STARTLINE}
 addUserKnob {1 input1UTXT l "Link 1" t "Type in the node name you want this input to connect to, or connect the input to the node to automatically populate the field with its name"}
 input1UTXT "Connect input 1 to set link"
 addUserKnob {1 input1LabelUTXT l Label t "Type in a custom label for this input. This can be displayed on the node label and/or in the node inputs" -STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {22 connectBTN l Connect t "Press this button to force the MagicSwitch to make direct connections \n\nThis is most useful when saving in templates or during copy/paste operations, to prevent the node from losing its relative links" T "def batch_connect_switches():\n    p = nuke.Panel(\"Connect MagicSwitches\")\n    p.addEnumerationPulldown(\"Apply To:\", \"Current Selected All\")\n    \n    if not p.show():\n        return\n        \n    # Retrieve user choice\n    apply_to = p.value(\"Apply To:\")\n    current_node = nuke.thisNode()\n    \n    # Run at root\n    with nuke.root():\n        \n        # Gather nodes\n        if apply_to == \"Current\":\n            nodes_to_check = \[current_node]\n        elif apply_to == \"Selected\":\n            nodes_to_check = nuke.selectedNodes()\n        else:\n            nodes_to_check = nuke.allNodes()\n            \n        # Connect the valid nodes\n        for node in nodes_to_check:\n            \n            # Only nodes that have custom input text knobs\n            if 'classTXT' in node.knobs() and \"MagicSwitch\" in node.knob('classTXT').value():\n                \n                name_0 = node.knob('input0UTXT').value()\n                name_1 = node.knob('input1UTXT').value()\n                \n                # Fetch target nodes. Ignors placeholder text\n                target_0 = nuke.toNode(name_0) if name_0 not in (\"\", \"Connect input 0 to set link\") else None\n                target_1 = nuke.toNode(name_1) if name_1 not in (\"\", \"Connect input 1 to set link\") else None\n                \n                # Connect\n                if target_0:\n                    node.setInput(0, target_0)\n                if target_1:\n                    node.setInput(1, target_1)\n\nbatch_connect_switches()" +STARTLINE}
 addUserKnob {22 setInputBTN l "Set Input" t "Press this button to batch change the \"Witch\" knobs of current, selected or all MagicScripts" -STARTLINE T "def batch_update_switches():\n    current_node = nuke.thisNode()\n    \n    # Create and show the panel\n    p = nuke.Panel(\"Batch Update MagicSwitches\")\n    p.addEnumerationPulldown(\"Apply To:\", \"Current Selected All\")\n    p.addEnumerationPulldown(\"Set Input To:\", \"0 1\")\n    \n    if not p.show():\n        return\n        \n    apply_to = p.value(\"Apply To:\")\n    target_input = int(p.value(\"Set Input To:\"))\n    \n    # Use Root Node Graph\n    with nuke.root():\n        if apply_to == \"Current\":\n            nodes_to_check = \[current_node]\n        elif apply_to == \"Selected\":\n            nodes_to_check = nuke.selectedNodes()\n        else:\n            nodes_to_check = nuke.allNodes()\n            \n        # Update the valid nodes\n        for node in nodes_to_check:\n            \n            # Ensure it's a MagicSwitch\n            if 'classTXT' in node.knobs() and \"MagicSwitch\" in node.knob('classTXT').value():\n                if 'witchKNB' in node.knobs() and 'disable' in node.knobs():\n                    node\['disable'].setValue(0)\n                    node\['witchKNB'].setValue(target_input)\n\nbatch_update_switches()"}
 addUserKnob {22 removeMagicBTN l "Remove Magic" t "Press this button to toggle between this node acting like a MagicSwitch or a regular boring switch" -STARTLINE T "def toggle_magic_switches():\n    current_node = nuke.thisNode()\n    button_knob = nuke.thisKnob()\n    \n    magic_knob = current_node.knob('disconnectInputsCHK')\n    if not magic_knob:\n        return\n        \n    # Determine the action based on this nodes state\n    is_magic_on = magic_knob.value()\n    target_state = not is_magic_on\n    action_name = \"Remove Magic\" if is_magic_on else \"Add Magic\"\n    new_button_label = \"Add Magic\" if is_magic_on else \"Remove Magic\"\n    \n    # Create and show the panel\n    p = nuke.Panel(\"\{\} (Convert Switches)\".format(action_name))\n    p.addEnumerationPulldown(\"Apply To:\", \"Current Selected All\")\n    \n    if not p.show():\n        return\n        \n    apply_to = p.value(\"Apply To:\")\n    button_name = button_knob.name()\n    \n    # Use Root Node Graph\n    with nuke.root():\n        \n        # Gather the nodes\n        if apply_to == \"Current\":\n            nodes_to_check = \[current_node]\n        elif apply_to == \"Selected\":\n            nodes_to_check = nuke.selectedNodes()\n        else:\n            nodes_to_check = nuke.allNodes()\n            \n        # Update the valid nodes\n        for node in nodes_to_check:\n            \n            # Ensure it's a MagicSwitch\n            if 'classTXT' in node.knobs() and \"MagicSwitch\" in node.knob('classTXT').value():                \n                node.knob('disconnectInputsCHK').setValue(target_state)\n                \n                #Update the button's visual label for next click\n                if button_name in node.knobs():\n                    node.knob(button_name).setLabel(new_button_label)\n\ntoggle_magic_switches()"}
 addUserKnob {22 resetBTN l Reset t "Press this button to reset the node to default state" -STARTLINE T "this_node = nuke.thisNode()\n\n# Remove inputs\nthis_node.setInput(0, None)\nthis_node.setInput(1, None)\n\n# Knob defaults\ndefault_states = \{\n    'input0UTXT': \"Connect input 0 to set link\",\n    'input1UTXT': \"Connect input 1 to set link\",\n    'input0LabelUTXT': \"\",\n    'input1LabelUTXT': \"\",\n    'disconnectInputsCHK': True,\n    'labelInputsCHK': True,\n    'showStateCHK': True,\n    'showInputLabelCHK': True\n\}\n\n# Apply the defaults\nfor knob_name, target_value in default_states.items():\n    k = this_node.knob(knob_name)\n    if k:\n        k.setValue(target_value)\n        \n# Put node into \"New\" state        \nthis_node.knob('newCHK').setValue(True)"}
 addUserKnob {20 advancedTAB l Advanced}
 addUserKnob {26 behaviourTXT l Behaviour}
 addUserKnob {6 disconnectInputsCHK l "Disconnect Inputs" t "Enabled =  MagicSwitch input Disconnecting \nDisabled = No magic :( inputs must remain connected" +STARTLINE}
 disconnectInputsCHK true
 addUserKnob {6 newCHK l New t "Used in the scripts to determine if the node is new, or in use" -STARTLINE +INVISIBLE}
 newCHK true
 addUserKnob {6 labelInputsCHK l "Use Labels For Input Names" t "Enabled =  The link labels are used for input names\nDisabled = standard 0-1 input names" +STARTLINE}
 labelInputsCHK true
 addUserKnob {6 showStateCHK l "Show Witch Value In Node Label" t "Enabled =  Display the current Witch knob value in node label\nDisabled = Don't display" +STARTLINE}
 showStateCHK true
 addUserKnob {6 showInputLabelCHK l "Show Current Input Label In Node Label" t "Enabled =  Display the current link label value in node label\nDisabled = Don't display" +STARTLINE}
 showInputLabelCHK true
 addUserKnob {26 colourTXT l Colours}
 addUserKnob {18 input0CKNB l "Link 0" t "The colour of the node when set to use link 0"}
 input0CKNB {0.78 0.78 0}
 addUserKnob {6 input0CKNB_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 input1CKNB l "Link 1" t "The colour of the node when set to use link 1"}
 input1CKNB {0 0.75 0}
 addUserKnob {6 input1CKNB_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 inputOtherCKNB l "Link Other" t "The colour of the node when set to use a link outside of the range 0-1"}
 inputOtherCKNB {0.5 0.5 0.5}
 addUserKnob {6 inputOtherCKNB_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 missingInputCKNB l "Link Missing" t "The colour of the node if a link can't be found in the current file"}
 missingInputCKNB {1 0 0}
 addUserKnob {6 missingInputCKNB_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 disabledCKNB l Disabled t "The colour of the node if disabled. By default this is expression linked to Link 0 because disabling the node also sets it to use link 0 "}
 disabledCKNB {{input0CKNB} {input0CKNB} {input0CKNB}}
 addUserKnob {6 disabledCKNB_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 backdropColourDimDBL l "Backdrop Dim" t "The amount to darken the \"MagicSwitch_BackdropNode\" colour compared to the values set above"}
 backdropColourDimDBL 0.75
 addUserKnob {20 infoTAB l Info}
 addUserKnob {26 aboutTXT l "&nbsp;" T "<h3>About</h3> \n<p>A switch that uses two dynamically connecting inputs.\n<br>Because it can disconnect a pipe completely,<br> it is often faster to use in large scripts</p> \n<hr>\n <h3>How To Use</h3> \n<p>Step 1: Connect the 0 input to the node you want 0 to link to</p>\n<p>Step 2: Connect the 1 input to the node you want 1 to link to </p>\n<p>Step 3: Use the \"Witch\" knob to change inputs and/or disable the node</p>\n<hr>\n\n"}
 addUserKnob {26 help1TXT l "&nbsp;" T "Press the "}
 addUserKnob {22 helpBTN l Help -STARTLINE T "import webbrowser\nwebbrowser.open(\"https://www.hiramgifford.com/nuke-tools-and-scripts/nuke-magic-switch\")"}
 addUserKnob {26 help2TXT l "&nbsp;" -STARTLINE T "button to view the full documentation"}
 addUserKnob {26 classTXT l "&nbsp;" T "<font color=grey><i>MagicSwitch</i>"}
 addUserKnob {26 versionTXT l "&nbsp;" -STARTLINE T "<font color=grey><i>v1.4</i>"}
 addUserKnob {26 infoTXT l "&nbsp;" T "<font color=grey><i>Hiram Gifford - 18/03/2026 - hiramgifford.com</i>"}
}
 Input {
  inputs 0
  name Input1
  xpos 178
  ypos -1
  number 1
 }
 Input {
  inputs 0
  name Input0
  xpos 0
 }
 Switch {
  inputs 2
  which {{parent.witchKNB}}
  name InternalSwitch
  xpos 86
  ypos 168
 }
 Output {
  name Output
  xpos 86
  ypos 315
 }
end_group
